{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kanban-flow-sync.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/Users/*/.claude/CLAUDE.md",
    "**/home/*/.claude/CLAUDE.md"
  ]
}
